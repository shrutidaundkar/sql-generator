# Copy to .env and fill in your keys. .env is gitignored — never commit it.
# One block per provider; all three speak the OpenAI wire format. A provider with any var
# missing is simply unavailable, and requests for it fall back to the default (gemini).

# Default.
GEMINI_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_LLM_API_KEY=
GEMINI_LLM_MODEL=gemini-3.6-flash

GROQ_LLM_BASE_URL=https://api.groq.com/openai/v1
GROQ_LLM_API_KEY=
GROQ_LLM_MODEL=llama-3.3-70b-versatile

# Local Ollama. Start the model first: `ollama run qwen2.5-coder:1.5b`.
# The key is ignored by Ollama but must be non-empty for the client.
LOCAL_LLM_BASE_URL=http://localhost:11434/v1
LOCAL_LLM_API_KEY=ollama
LOCAL_LLM_MODEL=qwen2.5-coder:1.5b
